{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bdns-baseline-transition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "migration_id",
    "source_id",
    "policy_id",
    "target_normalizer_version",
    "evidence_contract_version",
    "software_git_sha",
    "record_id",
    "from_record_snapshot_hash",
    "from_content_hash_version",
    "from_content_hash",
    "to_content_hash_version",
    "to_content_hash",
    "migration_reason",
    "migrated_at"
  ],
  "properties": {
    "from_record_snapshot_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "schema_version": {
      "const": "1.0"
    },
    "migration_id": {
      "type": "string",
      "pattern": "^bdns-v1-v2-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "source_id": {
      "const": "bdns"
    },
    "policy_id": {
      "const": "bdns.enriched-metadata-publication.v2"
    },
    "target_normalizer_version": {
      "const": "2.0.0"
    },
    "evidence_contract_version": {
      "const": "1.0"
    },
    "software_git_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "record_id": {
      "type": "string",
      "pattern": "^infocs:bdns:",
      "maxLength": 250
    },
    "from_content_hash_version": {
      "const": 1
    },
    "from_content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "to_content_hash_version": {
      "const": 2
    },
    "to_content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "migration_reason": {
      "const": "canonical_enrichment_v1_to_v2"
    },
    "migrated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
