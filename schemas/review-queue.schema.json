{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infocs.local/schemas/review-queue.schema.json",
  "title": "InfoCs BOE Pending Review Queue v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_id", "records"],
  "properties": {
    "schema_version": { "const": "1" },
    "source_id": { "const": "boe" },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id", "official_id", "source_url", "published_at", "run_id",
        "territorial_reason_codes", "entity_codes", "publication_decision", "reason_code"
      ],
      "properties": {
        "source_id": { "const": "boe" },
        "official_id": { "type": "string", "pattern": "^[A-Z0-9]+-[A-Z]-[0-9]{4}-[0-9]+$" },
        "source_url": { "type": "string", "format": "uri", "pattern": "^https://(www\\.)?boe\\.es/" },
        "published_at": { "type": "string", "format": "date" },
        "run_id": { "type": "string", "pattern": "^run-v1-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "territorial_reason_codes": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "enum": ["municipality_exact", "province_exact", "authority_exact"] }
        },
        "entity_codes": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,64}$" }
        },
        "publication_decision": { "const": "hold" },
        "reason_code": { "enum": ["not_in_allowlist", "personal_content_review", "territorial_review_required"] }
      }
    }
  }
}
