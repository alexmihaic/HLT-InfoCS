---
import type { FrontendRecord, SourceMeta } from '../lib/data/types';
import { encodeRecordId } from '../lib/data';
import { buildBDNSRecordView } from '../lib/presentation/bdnsRecordView';
import { categoryLabel, sourceLabel } from '../lib/presentation/labels';
import { derivedMunicipality } from '../lib/presentation/territory';
import EmptyState from './EmptyState.astro';
import RecordItem from './RecordItem.astro';
import ViewToggle from './ViewToggle.astro';

interface Props {
  records: readonly FrontendRecord[];
  sources: readonly SourceMeta[];
  historyIds: ReadonlySet<string>;
  countLabel?: string;
  emptyMessage?: string;
}
const { records, sources, historyIds, countLabel, emptyMessage = 'Todavía no hay publicaciones disponibles.' } = Astro.props;
---

<div class="records-toolbar">
  {countLabel && <p class="count-note" data-record-count>{countLabel}</p>}
  <ViewToggle />
</div>
{records.length === 0
  ? <EmptyState message={emptyMessage} />
  : <ol class="record-list" data-record-list>
    {records.map((record) => {
      const bdnsView = buildBDNSRecordView(record);
      const municipality = derivedMunicipality(record);
      return <li data-category={record.category} data-municipality={municipality?.code}><RecordItem record={record} href={`/registro/${encodeRecordId(record.id)}/`} source={sourceLabel(record.sourceId, sources)} category={categoryLabel(record.category)} hasHistory={historyIds.has(record.id)} bdnsSummary={bdnsView ? { callType: bdnsView.callType, budget: bdnsView.budget } : undefined} /></li>;
    })}
  </ol>}
<p class="empty-state" data-filter-empty hidden>No hay registros que cumplan los filtros seleccionados.</p>
