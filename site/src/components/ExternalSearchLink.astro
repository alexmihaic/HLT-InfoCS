---
interface Props { href: string }
const { href } = Astro.props;
---
<div class="external-search">
  <a class="external-search-link" href={href} target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer" data-external-search aria-describedby="external-search-note">
    <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="m16 16 4 4"></path></svg>
    <span>Buscar en Google</span>
    <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 5h5v5M19 5l-8 8M18 14v5H5V6h5"></path></svg>
    <span class="visually-hidden"> (se abre en una pestaña nueva)</span>
  </a>
  <p class="fact-note" id="external-search-note">Búsqueda externa: resultados de Google no verificados por InfoCs.</p>
</div>
