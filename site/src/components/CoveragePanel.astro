---
import SourceChecks from './SourceChecks.astro';
import type { SourceCoverageView } from '../lib/presentation/coverage';
interface Props { coverage: readonly SourceCoverageView[]; totalRecords: number }
const { coverage, totalRecords } = Astro.props;
---
<section class="home-coverage aside-panel surface-panel" aria-labelledby="coverage-title">
  <h3 id="coverage-title">Qué fuentes tienen contenido público</h3>
  <p class="count-note" id="ledger-title">{totalRecords} {totalRecords === 1 ? 'registro publicado' : 'registros publicados'} en InfoCs</p>
  <div class="coverage-list">
    {coverage.map(source => <section class="coverage-item">
      <h4>{source.detailPath ? <a class="text-link" href={source.detailPath}>{source.name}</a> : source.name}</h4>
      <p class="coverage-count">{source.recordCountLabel}</p>
      <p class="coverage-scope">{source.scope}</p>
      <SourceChecks source={source} compact />
    </section>)}
  </div>
  <p class="fact-note">Las ejecuciones indican cuándo InfoCs consultó cada fuente. La cobertura se limita a las publicaciones seleccionadas.</p>
</section>
