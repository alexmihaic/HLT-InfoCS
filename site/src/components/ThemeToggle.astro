<button class="theme-toggle" type="button" data-theme-toggle aria-label="Cambiar a modo claro" aria-pressed="false">Oscuro</button>

<script>
  const themeButton = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');

  function syncThemeButton() {
    const isLight = document.documentElement.dataset.theme === 'light';
    if (!themeButton) return;
    themeButton.textContent = isLight ? 'Claro' : 'Oscuro';
    themeButton.setAttribute('aria-label', isLight ? 'Cambiar a modo oscuro' : 'Cambiar a modo claro');
    themeButton.setAttribute('aria-pressed', String(isLight));
  }

  syncThemeButton();
  themeButton?.addEventListener('click', () => {
    const nextTheme = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
    document.documentElement.dataset.theme = nextTheme;
    try {
      localStorage.setItem('infocs-theme', nextTheme);
    } catch {
      // The selected theme remains active for this page even if storage is blocked.
    }
    syncThemeButton();
  });
</script>
