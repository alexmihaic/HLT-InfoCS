---
import type { FrontendRecord } from '../lib/data/types';
import type { PrimaryDateView } from '../lib/presentation/recordView';
import type { BDNSRecordView } from '../lib/presentation/bdnsRecordView';
import { authorityPresentation, officialDeadline } from '../lib/presentation/recordView';
import DateValue from './DateValue.astro';
import RecordMeta from './RecordMeta.astro';
import SourceLink from './SourceLink.astro';

interface Props {
  record: FrontendRecord;
  href: string;
  source: string;
  category: string;
  date: PrimaryDateView;
  geography: readonly string[];
  hasHistory: boolean;
  bdnsSummary?: Pick<BDNSRecordView, 'callType' | 'budget'>;
}
const { record, href, source, category, date, geography, hasHistory, bdnsSummary } = Astro.props;
const authority = authorityPresentation(record);
const deadline = officialDeadline(record);
---

<article class="record-card">
  <div class="record-card-header"><RecordMeta source={source} category={category} />{hasHistory && <span class="history-indicator">Historial</span>}</div>
  <h3><a href={href}>{record.title}</a></h3>
  {authority && (record.sourceId === 'boe'
    ? <p class="record-authority"><span class="muted">{authority.label}: </span>{authority.value}</p>
    : <p class="record-authority">{authority.value}</p>)}
  {geography.length > 0 && <ul class="geography-list" aria-label="Ámbito territorial">{geography.map((label) => <li>{label}</li>)}</ul>}
  {((bdnsSummary && (bdnsSummary.callType || bdnsSummary.budget)) || deadline) && <dl class="record-card-bdns-summary">
    {bdnsSummary?.callType && <div><dt>Tipo de convocatoria</dt><dd>{bdnsSummary.callType.value}</dd></div>}
    {bdnsSummary?.budget && <div><dt>Presupuesto de la convocatoria</dt><dd>{bdnsSummary.budget.displayValue}{bdnsSummary.budget.currency && <span> · {bdnsSummary.budget.currency}</span>}{bdnsSummary.budget.currencyNotice && <span class="muted">{bdnsSummary.budget.currencyNotice}</span>}</dd></div>}
    {deadline && <div><dt>{deadline.label}</dt><dd>{deadline.date && <time datetime={deadline.date.value}>{deadline.date.display}</time>}{deadline.date && deadline.text && <span> · </span>}{deadline.text && <span>{deadline.text}</span>}</dd></div>}
  </dl>}
  <div class="record-card-footer">
    <DateValue label={date.label} value={date.value} display={date.display} />
    <SourceLink href={record.sourceUrl} label="Fuente" />
  </div>
</article>
