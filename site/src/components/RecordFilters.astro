---
import type { FrontendRecord, SourceMeta } from '../lib/data/types';
import { categoryLabel, sourceLabel } from '../lib/presentation/labels';
import { authorityOptions, callTypeOptions } from '../lib/presentation/recordFilters';
import { derivedMunicipality, municipalityShortName } from '../lib/presentation/territory';

interface Props { records: readonly FrontendRecord[]; sources: readonly SourceMeta[] }
const { records, sources } = Astro.props;

const categories = new Map<string, number>();
const municipalities = new Map<string, { name: string; count: number }>();
for (const record of records) {
  categories.set(record.category, (categories.get(record.category) ?? 0) + 1);
  const municipality = derivedMunicipality(record);
  if (municipality) {
    const current = municipalities.get(municipality.code) ?? { name: municipalityShortName(municipality.name), count: 0 };
    municipalities.set(municipality.code, { ...current, count: current.count + 1 });
  }
}
const categoryOptions = [...categories.entries()]
  .map(([value, count]) => ({ value, label: categoryLabel(value), count }))
  .sort((left, right) => left.label.localeCompare(right.label, 'es'));
const municipalityOptions = [...municipalities.entries()]
  .map(([value, { name, count }]) => ({ value, label: name, count }))
  .sort((left, right) => left.label.localeCompare(right.label, 'es'));
const callTypes = callTypeOptions(records);
const authorities = authorityOptions(records);
const sourceOptions = [...new Set(records.map(record => record.sourceId))].map(value => ({ value, label: sourceLabel(value, sources), count: records.filter(record => record.sourceId === value).length }));
---

<form class="record-filters" action="/registros/" method="get" data-record-filters aria-label="Filtrar registros">
  <div class="record-filter">
    <label for="filter-tipo">Tipo</label>
    <select id="filter-tipo" name="tipo">
      <option value="">Todos los tipos</option>
      {categoryOptions.map((option) => <option value={option.value}>{option.label} ({option.count})</option>)}
    </select>
  </div>
  {callTypes.length > 0 && <div class="record-filter">
    <label for="filter-convocatoria">Tipo de convocatoria BDNS</label>
    <select id="filter-convocatoria" name="convocatoria">
      <option value="">Todos</option>
      {callTypes.map((option) => <option value={option.value}>{option.label} ({option.count})</option>)}
    </select>
  </div>}
  <div class="record-filter">
    <label for="filter-municipio">Municipio mencionado en el título (BOE)</label>
    <select id="filter-municipio" name="municipio">
      <option value="">Todos</option>
      {municipalityOptions.map((option) => <option value={option.value}>{option.label} ({option.count})</option>)}
    </select>
  </div>
  <div class="record-filter">
    <label for="filter-organismo">Administración convocante (según BDNS)</label>
    <select id="filter-organismo" name="organismo" aria-describedby="filter-scope-note">
      <option value="">Todas</option>
      {authorities.map(option => <option value={option.value}>{option.label} ({option.count})</option>)}
    </select>
  </div>
  {sourceOptions.length > 1 && <div class="record-filter">
    <label for="filter-fuente">Fuente oficial</label>
    <select id="filter-fuente" name="fuente">
      <option value="">Todas las fuentes</option>
      {sourceOptions.map(option => <option value={option.value}>{option.label} ({option.count})</option>)}
    </select>
  </div>}
  <div class="record-filter">
    <label for="filter-desde">Fecha mostrada · desde</label>
    <input id="filter-desde" type="date" name="desde" aria-describedby="filter-date-note filter-date-error" />
  </div>
  <div class="record-filter">
    <label for="filter-hasta">Fecha mostrada · hasta</label>
    <input id="filter-hasta" type="date" name="hasta" aria-describedby="filter-date-note filter-date-error" />
  </div>
  <p id="filter-date-error" class="record-filter-note" role="status" hidden>El inicio es posterior al final. Corrige el intervalo o quita los filtros.</p>
  <p id="filter-date-note" class="fact-note record-filter-note">Intervalo inclusivo sobre la fecha de cada ficha: publicación; si falta, recepción en BDNS; si también falta, detección por InfoCs. No es el plazo de solicitud.</p>
  <div class="record-filter-actions"><button class="record-filter-reset" type="button" data-filter-reset hidden>Quitar filtros</button></div>
  <noscript><p>Los filtros necesitan JavaScript. Puedes consultar el listado completo, <a href="/organismos/">Organismos</a> y <a href="/fuentes/">Fuentes</a>.</p></noscript>
  <p id="filter-scope-note" class="fact-note record-filter-note">Los recuentos indican coincidencias con los demás filtros. La administración agrupa por el nombre literal del nivel 2 de la jerarquía oficial BDNS, como en <a href="/organismos/">Organismos</a>; no es el municipio beneficiario. Nombres iguales se agrupan; no necesariamente identifican jurídicamente al organismo convocante exacto. El municipio solo se busca en títulos BOE. El tipo de convocatoria no determina quién puede solicitarla ni la vigencia del plazo.</p>
</form>

<script>
  import '../scripts/recordFilters';
</script>
