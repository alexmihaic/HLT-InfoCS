---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

interface Props {
  title: string;
  description?: string;
  currentPage?: 'home' | 'records' | 'organisms' | 'search' | 'changes' | 'sources' | 'methodology';
}

const {
  title,
  description = 'Actividad pública de Castellón a partir de fuentes oficiales.',
  currentPage,
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} · InfoCs</title>
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#07111d" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var preference = 'auto';
        var view = 'list';
        try {
          var savedTheme = localStorage.getItem('infocs-theme');
          if (savedTheme === 'light' || savedTheme === 'dark' || savedTheme === 'auto') preference = savedTheme;
          if (localStorage.getItem('infocs-view') === 'cards') view = 'cards';
        } catch (error) {}
        var prefersLight = false;
        try { prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches; } catch (error) {}
        root.dataset.themePreference = preference;
        root.dataset.theme = preference === 'auto' ? (prefersLight ? 'light' : 'dark') : preference;
        root.dataset.recordView = view;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header currentPage={currentPage} />
    <main id="contenido" class="shell">
      <slot />
    </main>
    <Footer />
  </body>
</html>
