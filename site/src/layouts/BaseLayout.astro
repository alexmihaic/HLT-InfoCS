---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

interface Props {
  title: string;
  description?: string;
  currentPage?: 'home' | 'search' | 'changes' | 'sources' | 'methodology';
}

const {
  title,
  description = 'Actividad pública de Castellón a partir de fuentes oficiales.',
  currentPage,
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} · InfoCs</title>
    <script is:inline>
      try {
        const savedTheme = localStorage.getItem('infocs-theme');
        document.documentElement.dataset.theme = savedTheme === 'light' ? 'light' : 'dark';
      } catch {
        document.documentElement.dataset.theme = 'dark';
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header currentPage={currentPage} />
    <main id="contenido" class="shell">
      <slot />
    </main>
    <Footer />
  </body>
</html>
