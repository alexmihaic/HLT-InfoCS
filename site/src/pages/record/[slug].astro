---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { encodeRecordId, loadPortalData } from '../../lib/data';
import { formatPortalDate } from '../../lib/presentation/dates';
import { administrationLevelLabel, categoryLabel, eventDescription, sourceLabel } from '../../lib/presentation/labels';
import { geographyLabels } from '../../lib/presentation/recordView';
import type { FrontendEvent, FrontendRecord, SourceMeta } from '../../lib/data/types';

interface Props {
  record: FrontendRecord;
  events: readonly FrontendEvent[];
  source: SourceMeta;
}

export async function getStaticPaths() {
  const data = await loadPortalData();
  return data.records.map((record) => {
    const source = data.sources.find((item) => item.sourceId === record.sourceId);
    if (!source) throw new Error('No se encontró la metadata editorial de una fuente publicada.');
    return {
      params: { slug: encodeRecordId(record.id) },
      props: { record, events: data.eventsByRecordId.get(record.id) ?? [], source },
    };
  });
}

const { record, events, source } = Astro.props as Props;
const geography = geographyLabels(record);
const grantAmount = record.category === 'grants.call' ? record.financial?.grantAmount : undefined;
const isBDNSCall = record.sourceId === 'bdns' && record.category === 'grants.call';
---

<BaseLayout title={record.title} description={`Ficha pública de ${categoryLabel(record.category)} en InfoCs.`}>
  <article class="detail-page">
    <nav class="breadcrumbs" aria-label="Ruta de navegación">
      <a href="/">Inicio</a><span aria-hidden="true">/</span><span aria-current="page">Ficha de publicación</span>
    </nav>

    <header class="detail-header">
      <p class="record-meta">
        <span class="source-label">{sourceLabel(record.sourceId, [source])}</span>
        <span class="category-label">{categoryLabel(record.category)}</span>
      </p>
      <h1>{record.title}</h1>
      {record.authority && <p class="detail-authority">{record.authority.name}</p>}
    </header>

    <section class="detail-section" aria-labelledby="publication-data-title">
      <h2 id="publication-data-title">Datos de la publicación</h2>
      <dl class="detail-grid">
        {record.authority && <div><dt>Organismo</dt><dd>{record.authority.name}</dd></div>}
        {record.administrationLevel && <div><dt>Nivel administrativo</dt><dd>{administrationLevelLabel(record.administrationLevel)}</dd></div>}
        {record.publishedAt && <div><dt>Publicado</dt><dd><time datetime={record.publishedAt}>{formatPortalDate(record.publishedAt)}</time></dd></div>}
        {record.eventAt && <div><dt>Fecha del acto</dt><dd><time datetime={record.eventAt}>{formatPortalDate(record.eventAt)}</time></dd></div>}
        <div><dt>Detectado por InfoCs</dt><dd><time datetime={record.detectedAt}>{formatPortalDate(record.detectedAt)}</time></dd></div>
        <div><dt>Última comprobación</dt><dd><time datetime={record.lastCheckedAt}>{formatPortalDate(record.lastCheckedAt)}</time></dd></div>
        {geography.length > 0 && <div><dt>Ámbito territorial según la fuente y su normalización</dt><dd>{geography.join(' · ')}</dd></div>}
        {isBDNSCall && record.grant?.callId && <div><dt>Código BDNS</dt><dd>{record.grant.callId}</dd></div>}
        {grantAmount && <div><dt>Importe de la convocatoria</dt><dd>{grantAmount.value} {grantAmount.currency}</dd></div>}
      </dl>
    </section>

    <section class="detail-section official-source" aria-labelledby="official-source-title">
      <h2 id="official-source-title">Fuente oficial</h2>
      <p>Consulta el contenido original en el sitio del organismo editor.</p>
      <a class="button-link" href={record.sourceUrl} target="_blank" rel="noopener noreferrer">Abrir publicación oficial <span aria-hidden="true">↗</span></a>
      {source.attribution && <p class="attribution">{source.attribution}</p>}
    </section>

    <section class="detail-section methodology-note" aria-labelledby="processing-title">
      <h2 id="processing-title">Cómo organiza InfoCs esta ficha</h2>
      <p>InfoCs estructura metadatos de la fuente y conserva su enlace. Los campos opcionales sólo se muestran cuando están disponibles; la ficha no sustituye al documento oficial ni ofrece asesoramiento jurídico.</p>
    </section>

    {events.length > 0 ? (
      <section class="detail-section timeline" aria-labelledby="timeline-title">
        <h2 id="timeline-title">Historial</h2>
        <ol class="event-list">
          {events.map((event) => (
            <li>
              <article class="event-row">
                <p>{eventDescription(event)}</p>
                <time datetime={event.observedAt}>{formatPortalDate(event.observedAt)}</time>
              </article>
            </li>
          ))}
        </ol>
      </section>
    ) : (
      <p class="history-note">InfoCs no tiene un historial registrado para esta publicación.</p>
    )}
  </article>
</BaseLayout>
