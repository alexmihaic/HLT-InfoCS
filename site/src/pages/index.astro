---
import BaseLayout from '../layouts/BaseLayout.astro';
import RecordCard from '../components/RecordCard.astro';
import EmptyState from '../components/EmptyState.astro';
import StatusBadge from '../components/StatusBadge.astro';
import { encodeRecordId, loadPortalData } from '../lib/data';
import { categoryLabel, sourceLabel } from '../lib/presentation/labels';
import { geographyLabels, primaryDate } from '../lib/presentation/recordView';

const data = await loadPortalData();
---

<BaseLayout
  title="Últimas publicaciones relevantes para Castellón"
  description="Publicaciones oficiales organizadas por InfoCs, con procedencia y acceso a la fuente original."
  currentPage="explore"
>
  <section class="home-hero" aria-labelledby="page-title">
    <div>
      <p class="eyebrow">Datos públicos · fuentes oficiales</p>
      <h1 id="page-title">Actividad pública de Castellón desde las fuentes oficiales.</h1>
      <p class="lede">InfoCs reúne publicaciones verificables, conserva su procedencia y ayuda a consultarlas con menos fricción.</p>
    </div>
    <p class="hero-note">Una ciudadanía más fuerte empieza por saber qué se publica y dónde comprobarlo.</p>
  </section>

  <section class="page-section" aria-labelledby="records-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Orden cronológico</p>
        <h2 id="records-title">Publicaciones</h2>
      </div>
      <p class="count-note">{data.records.length} {data.records.length === 1 ? 'registro público' : 'registros públicos'}</p>
    </div>

    {data.records.length === 0 ? (
      <EmptyState message="Todavía no hay publicaciones disponibles. Consulta las fuentes oficiales para acceder a sus contenidos." />
    ) : (
      <ol class="record-list">
        {data.records.map((record) => {
          const history = data.eventsByRecordId.get(record.id) ?? [];
          return (
            <li>
              <RecordCard record={record} href={`/registro/${encodeRecordId(record.id)}/`} source={sourceLabel(record.sourceId, data.sources)} category={categoryLabel(record.category)} date={primaryDate(record)} geography={geographyLabels(record)} hasHistory={history.length > 0} />
            </li>
          );
        })}
      </ol>
    )}
  </section>

  <section class="page-section" aria-labelledby="source-summary-title">
    <div class="section-heading"><div><p class="eyebrow">Procedencia</p><h2 id="source-summary-title">Fuentes integradas</h2></div><a class="text-link" href="/fuentes/">Cómo se recogen →</a></div>
    <div class="source-summary-grid">
      {data.sources.map((source) => (
        <article class="source-tile">
          <div class="source-tile-header"><h3>{sourceLabel(source.sourceId, data.sources)}</h3><StatusBadge label={source.statusLabel} tone={source.publicationState === 'publication_pending' ? 'pending' : 'active'} /></div>
          <p>{source.summary}</p>
          <p class="count-note">{source.publicationState === 'publication_pending'
            ? 'Sin registros públicos en InfoCs'
            : `${source.recordCount} ${source.recordCount === 1 ? 'registro disponible' : 'registros disponibles'}`}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="page-section" aria-labelledby="method-summary-title">
    <div class="surface-panel">
      <p class="eyebrow">Procedencia</p>
      <h2 id="method-summary-title">Datos oficiales, organizados con claridad</h2>
      <p class="method-note">InfoCs conserva enlaces a las fuentes, normaliza metadatos con reglas explícitas y registra observaciones cuando hay historial. El estado de una fuente aquí es editorial, no un indicador de salud técnica.</p>
    </div>
  </section>
</BaseLayout>
