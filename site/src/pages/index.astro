---
import BaseLayout from '../layouts/BaseLayout.astro';
import RecordList from '../components/RecordList.astro';
import StatusBadge from '../components/StatusBadge.astro';
import { loadPortalData } from '../lib/data';
import { loadPortalStatus } from '../lib/data/status';
import { sourceLabel } from '../lib/presentation/labels';
import { byPrimaryDateDesc } from '../lib/presentation/recordView';
import { NOT_COVERED, sourceCoverage } from '../lib/presentation/coverage';
import { AUTHORITY_GROUP_LABEL, authorityGroups } from '../lib/presentation/authorities';
import { formatPortalDateTime } from '../lib/presentation/dates';

const HOME_RECORD_LIMIT = 20;
const HOME_ORGANISM_LIMIT = 8;

const data = await loadPortalData();
const status = await loadPortalStatus(data.sources.map((source) => source.sourceId));
const coverage = sourceCoverage(data.sources, status);
const recent = [...data.records].sort(byPrimaryDateDesc).slice(0, HOME_RECORD_LIMIT);
const organisms = authorityGroups(data.records);
const publishedSources = coverage.filter((source) => source.published);
const historyIds = new Set(data.eventsByRecordId.keys());
---

<BaseLayout
  title="Actividad pública de Castellón desde fuentes oficiales"
  description="Publicaciones oficiales relevantes para Castellón, con procedencia, cobertura y acceso a la fuente original."
  currentPage="home"
>
  <section class="home-intro" aria-labelledby="page-title">
    <div class="home-intro-copy">
      <p class="eyebrow">Datos públicos · fuentes oficiales</p>
      <h1 id="page-title">Actividad pública de Castellón desde las fuentes oficiales</h1>
      <p class="lede">InfoCs reúne publicaciones oficiales que afectan a Castelló de la Plana y a la provincia de Castellón. Cada ficha enlaza a la fuente original, que es siempre la referencia válida.</p>
    </div>
    <nav class="home-uses" aria-labelledby="what-title">
      <h2 id="what-title" class="home-uses-title">Qué puedes consultar</h2>
      <ul>
        <li><a href="/fuentes/bdns/"><strong>Convocatorias de subvenciones</strong><span>Presupuesto, plazo y destinatarios tal como los publica BDNS</span></a></li>
        <li><a href="/organismos/"><strong>Administraciones convocantes</strong><span>{organisms.length} {organisms.length === 1 ? 'administración' : 'administraciones'} según BDNS</span></a></li>
        <li><a href="/fuentes/boe/"><strong>Publicaciones del BOE</strong><span>Relacionadas con Castellón, tras revisión</span></a></li>
        <li><a href="/buscar/"><strong>Buscar</strong><span>Por título, organismo o término</span></a></li>
      </ul>
    </nav>
  </section>

  <dl class="stat-strip" aria-label="Indicadores del portal">
    <div><dt>Registros publicados</dt><dd>{data.records.length}</dd></div>
    <div><dt>Administraciones convocantes (BDNS)</dt><dd>{organisms.length}</dd></div>
    {status.boePendingReview !== undefined && <div><dt>BOE pendientes de revisión</dt><dd>{status.boePendingReview}</dd></div>}
    <div class="stat-strip-link"><dt class="visually-hidden">Cobertura</dt><dd><a class="text-link" href="#coverage-title">Cobertura y última actualización →</a></dd></div>
  </dl>

  <div class="home-columns page-section">
    <section class="home-coverage aside-panel surface-panel" aria-labelledby="coverage-title">
      <p class="panel-kicker">Cobertura y actualización</p>
      <h2 id="coverage-title">Qué fuentes tienen contenido público</h2>
      <p class="count-note">{data.records.length} {data.records.length === 1 ? 'registro publicado' : 'registros publicados'} en {publishedSources.length} {publishedSources.length === 1 ? 'fuente' : 'fuentes'}</p>
      <div class="coverage-list">
        {coverage.map((source) => (
          <article class="coverage-item">
            <header class="coverage-item-header">
              <h3>{sourceLabel(source.sourceId, data.sources)}</h3>
              <StatusBadge label={source.statusLabel} tone={source.statusTone} />
            </header>
            {source.facts.length > 0 && <dl class="coverage-facts">
              {source.facts.map((fact) => <div><dt>{fact.label}</dt><dd>{fact.datetime ? <time datetime={fact.datetime}>{fact.value}</time> : fact.value}</dd></div>)}
            </dl>}
            <p class="coverage-scope">{source.scope}</p>
            <div class="coverage-item-foot">
              <p class="coverage-count">{source.recordCountLabel}</p>
              {source.detailPath && <a class="text-link" href={source.detailPath}>Ficha de la fuente →</a>}
            </div>
          </article>
        ))}
      </div>
      <details class="coverage-explainer">
        <summary>Qué indican estas fechas</summary>
        <p class="fact-note">Las fechas de ejecución indican cuándo InfoCs completó por última vez una comprobación de la fuente; no garantizan que la fuente oficial no tenga publicaciones posteriores ni sustituyen las fechas oficiales de cada publicación. Una ejecución sin incidencias tampoco significa que se recoja toda la información de una administración.</p>
      </details>
    </section>

    <section class="home-recent" aria-labelledby="records-title">
      <div class="section-heading">
        <div><p class="eyebrow">Más recientes primero</p><h2 id="records-title">Últimas publicaciones</h2></div>
        <a class="text-link" href="/registros/">Ver los {data.records.length} registros →</a>
      </div>
      <RecordList records={recent} sources={data.sources} historyIds={historyIds} emptyMessage="Todavía no hay publicaciones disponibles. Consulta las fuentes oficiales para acceder a sus contenidos." />
      <p class="fact-note home-dates-note">«Publicado» es la fecha oficial de publicación; «Recibida en BDNS» es la fecha oficial en que BDNS registró la convocatoria, que no es una fecha de publicación; «Detectado por InfoCs» es cuándo InfoCs la observó por primera vez.</p>
    </section>

    <aside class="home-aside" aria-label="Explorar y límites">

      <section class="aside-panel surface-panel" aria-labelledby="organisms-title">
        <p class="panel-kicker">{AUTHORITY_GROUP_LABEL}</p>
        <h2 id="organisms-title">Explorar por administración</h2>
        <ol class="organism-mini-list">
          {organisms.slice(0, HOME_ORGANISM_LIMIT).map((group) => <li><a href={`/organismos/${group.slug}/`}><span>{group.name}</span><span class="count-note">{group.records.length}</span></a></li>)}
        </ol>
        <a class="text-link" href="/organismos/">Ver las {organisms.length} administraciones →</a>
      </section>

      <section class="aside-panel surface-panel" aria-labelledby="not-covered-title">
        <p class="panel-kicker">Límites actuales</p>
        <h2 id="not-covered-title">Qué no cubre todavía InfoCs</h2>
        <dl class="not-covered-list">
          {NOT_COVERED.map((item) => <div><dt>{item.title}</dt><dd>{item.detail}</dd></div>)}
        </dl>
      </section>
    </aside>
  </div>

  <p class="count-note build-note">Portal generado el <time datetime={status.builtAt}>{formatPortalDateTime(status.builtAt)}</time> a partir de los datos públicos disponibles en ese momento.</p>
</BaseLayout>
