---
import '../styles/home.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import RecordList from '../components/RecordList.astro';
import CoveragePanel from '../components/CoveragePanel.astro';
import { loadPortalData } from '../lib/data';
import { loadPortalStatus } from '../lib/data/status';
import { byPrimaryDateDesc, primaryDate } from '../lib/presentation/recordView';
import { sourceCoverage, NOT_COVERED } from '../lib/presentation/coverage';
import { formatPortalDateTime } from '../lib/presentation/dates';

const data = await loadPortalData();
const status = await loadPortalStatus(data.sources.map(source => source.sourceId));
const coverage = sourceCoverage(data.sources, status);
const recent = [...data.records].sort(byPrimaryDateDesc).slice(0, 10);
const historyIds = new Set(data.eventsByRecordId.keys());
const actions = [
  { href: '/registros/', title: 'Ver actividad pública', note: 'Lee las publicaciones por fecha.' },
  { href: '/organismos/', title: 'Explorar por administración', note: 'Consulta convocatorias según BDNS.', id: 'organisms-title' },
  { href: '/cambios/', title: 'Ver cambios observados', note: 'Consulta qué ha cambiado y cuándo.' },
];

const windowDays = 30;
const end = Date.parse(status.builtAt);
const start = end - windowDays * 86_400_000;
const totals = new Map<string, number>();
for (const record of data.records) {
  const date = primaryDate(record);
  const day = Date.parse(date.value.slice(0, 10));
  if (day >= start && day <= end) totals.set(date.label, (totals.get(date.label) ?? 0) + 1);
}
---

<BaseLayout title="Actividad pública en la provincia de Castellón" description="Consulta publicaciones de BOE y BDNS seleccionadas por InfoCs para la provincia de Castellón, sus cambios y sus fuentes." currentPage="home">
  <section class="civic-intro" aria-labelledby="page-title">
    <div class="civic-heading">
      <p class="civic-location">Provincia de Castellón</p>
      <h1 id="page-title">¿Qué han publicado las administraciones?</h1>
      <p class="lede">Consulta una selección de publicaciones oficiales y comprueba su origen.</p>
      <form action="/buscar/" method="get" role="search" class="civic-search">
        <label for="home-search">Buscar en las publicaciones</label>
        <div class="civic-search-field">
          <input id="home-search" name="q" type="search" placeholder="Título o código" />
          <button type="submit">Buscar</button>
        </div>
      </form>
    </div>
    <div class="civic-coverage-summary">
      <p><strong>{data.records.length} {data.records.length === 1 ? 'publicación' : 'publicaciones'}</strong>
        {coverage.some(source => source.published) && <span> · {coverage.filter(source => source.published).map(source => source.name).join(' y ')}</span>}
      </p>
      <a href="/fuentes/">Ver cobertura <span aria-hidden="true">→</span></a>
    </div>
    <nav class="civic-actions" aria-labelledby="doors-title">
      <h2 id="doors-title">Qué puedes consultar</h2>
      <ul>
        {actions.map(action => <li><a href={action.href} id={action.id}>
          <strong>{action.title}</strong>
          <span>{action.note}</span>
          <span class="civic-arrow" aria-hidden="true">→</span>
        </a></li>)}
      </ul>
    </nav>
  </section>

  <div class="civic-body">
    <section class="civic-stream" aria-labelledby="records-title">
      <header><h2 id="records-title">Últimas publicaciones</h2><a class="text-link" href="/registros/">Ver toda la actividad →</a></header>
      <p class="civic-date-note">Cada fila indica si la fecha es de publicación, recepción en BDNS o primera detección por InfoCs.</p>
      <RecordList records={recent} sources={data.sources} historyIds={historyIds} emptyMessage="Todavía no hay publicaciones disponibles en la cobertura de InfoCs. Consulta las fuentes oficiales." />
      {totals.size > 0 && <details class="civic-details"><summary>Recuento de los últimos {windowDays} días</summary>
        <p>Publicaciones del portal cuya fecha mostrada cae en los {windowDays} días anteriores a la generación de esta página, agrupadas por el significado de esa fecha.</p>
        <dl>{[...totals].map(([label, count]) => <div><dt>{label}</dt><dd>{count}</dd></div>)}</dl>
      </details>}
    </section>
    <aside class="civic-coverage" aria-labelledby="scope-title">
      <h2 id="scope-title"><a href="/fuentes/">Fuentes y cobertura →</a></h2>
      <CoveragePanel coverage={coverage} totalRecords={data.records.length} />
      <details class="civic-details"><summary>Qué no cubre todavía InfoCs</summary>
        <dl>{NOT_COVERED.map(item => <div><dt>{item.title}</dt><dd>{item.detail}</dd></div>)}</dl>
      </details>
      <p class="fact-note">Portal generado el <time datetime={status.builtAt}>{formatPortalDateTime(status.builtAt)}</time>.</p>
    </aside>
  </div>
</BaseLayout>
