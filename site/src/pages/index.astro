---
import BaseLayout from '../layouts/BaseLayout.astro';
import { encodeRecordId, loadPortalData } from '../lib/data';
import { categoryLabel, sourceLabel } from '../lib/presentation/labels';
import { geographyLabels, primaryDate } from '../lib/presentation/recordView';

const data = await loadPortalData();
---

<BaseLayout
  title="Últimas publicaciones relevantes para Castellón"
  description="Publicaciones oficiales organizadas por InfoCs, con procedencia y acceso a la fuente original."
  currentPage="home"
>
  <section class="home-intro" aria-labelledby="page-title">
    <p class="eyebrow">Actividad pública · Castellón</p>
    <h1 id="page-title">Últimas publicaciones relevantes para Castellón</h1>
    <p class="lede">InfoCs organiza publicaciones de fuentes oficiales para facilitar su consulta. Cada ficha conserva el enlace de origen y distingue la fecha publicada de la fecha en que InfoCs la detectó.</p>
  </section>

  <section class="feed-section" aria-labelledby="records-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Orden cronológico</p>
        <h2 id="records-title">Publicaciones</h2>
      </div>
      <p class="muted">{data.records.length} {data.records.length === 1 ? 'publicación disponible' : 'publicaciones disponibles'}</p>
    </div>

    {data.records.length === 0 ? (
      <p class="empty-state">Todavía no hay publicaciones disponibles. Consulta las fuentes oficiales para acceder a sus contenidos.</p>
    ) : (
      <ol class="record-list">
        {data.records.map((record) => {
          const date = primaryDate(record);
          const source = sourceLabel(record.sourceId, data.sources);
          const history = data.eventsByRecordId.get(record.id) ?? [];
          const geography = geographyLabels(record);
          return (
            <li>
              <article class="record-item">
                <p class="record-meta">
                  <span class="source-label">{source}</span>
                  <span class="category-label">{categoryLabel(record.category)}</span>
                </p>
                <h3><a href={`/record/${encodeRecordId(record.id)}/`}>{record.title}</a></h3>
                {record.authority && <p class="record-authority">{record.authority.name}</p>}
                {geography.length > 0 && (
                  <ul class="geography-list" aria-label="Ámbito territorial">
                    {geography.map((label) => <li>{label}</li>)}
                  </ul>
                )}
                <div class="record-footer">
                  <time datetime={date.value}><span>{date.label}:</span> {date.display}</time>
                  {history.length > 0 && <span class="history-indicator">Historial disponible</span>}
                  <a class="text-link" href={record.sourceUrl} target="_blank" rel="noopener noreferrer">Fuente oficial ↗</a>
                </div>
              </article>
            </li>
          );
        })}
      </ol>
    )}
  </section>

  <section class="source-summary" aria-labelledby="source-summary-title">
    <div>
      <p class="eyebrow">Procedencia</p>
      <h2 id="source-summary-title">Fuentes integradas</h2>
      <p class="muted">El estado indica disponibilidad editorial en InfoCs, no salud técnica de la fuente.</p>
      <ul class="home-source-list">
        {data.sources.map((source) => (
          <li>
            <span>{sourceLabel(source.sourceId, data.sources)}</span>
            <span>{source.publicationState === 'publication_pending'
              ? source.statusLabel
              : `${source.statusLabel} · ${source.recordCount} ${source.recordCount === 1 ? 'publicación' : 'publicaciones'}`}</span>
          </li>
        ))}
      </ul>
    </div>
    <a class="text-link" href="/fuentes/">Conocer las fuentes y el método →</a>
  </section>
</BaseLayout>
