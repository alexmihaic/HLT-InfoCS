---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RecordFilters from '../../components/RecordFilters.astro';
import RecordList from '../../components/RecordList.astro';
import { loadPortalData } from '../../lib/data';
import { byPrimaryDateDesc } from '../../lib/presentation/recordView';

const data = await loadPortalData();
const records = [...data.records].sort(byPrimaryDateDesc);
---

<BaseLayout title="Todos los registros" description="Todas las publicaciones oficiales que InfoCs ha incorporado al portal." currentPage="records">
  <header class="page-intro">
    <p class="eyebrow">Publicaciones oficiales</p>
    <h1>Todos los registros</h1>
    <p class="lede">Del más reciente al más antiguo según su fecha oficial o, si no existe, la fecha en que InfoCs los detectó.</p>
  </header>

  <section aria-label="Registros">
    <RecordFilters records={records} />
    <RecordList records={records} sources={data.sources} historyIds={new Set(data.eventsByRecordId.keys())} headingLevel={2} callTypeDisplay="meta" countLabel={`${records.length} ${records.length === 1 ? 'registro publicado' : 'registros publicados'}`} />
  </section>
</BaseLayout>
