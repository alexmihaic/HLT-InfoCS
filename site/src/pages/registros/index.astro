---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RecordCard from '../../components/RecordCard.astro';
import EmptyState from '../../components/EmptyState.astro';
import { encodeRecordId, loadPortalData } from '../../lib/data';
import { categoryLabel, sourceLabel } from '../../lib/presentation/labels';
import { byPrimaryDateDesc, geographyLabels, primaryDate } from '../../lib/presentation/recordView';
import { buildBDNSRecordView } from '../../lib/presentation/bdnsRecordView';

const data = await loadPortalData();
const records = [...data.records].sort(byPrimaryDateDesc);
---

<BaseLayout title="Todos los registros" description="Todas las publicaciones oficiales que InfoCs ha incorporado al portal." currentPage="records">
  <section class="page-intro" aria-labelledby="page-title">
    <p class="eyebrow">Publicaciones oficiales</p>
    <h1 id="page-title">Todos los registros</h1>
    <p class="lede">Registros publicados en InfoCs, del más reciente al más antiguo según su fecha oficial o, si no existe, la fecha en que InfoCs los detectó.</p>
  </section>

  <section aria-labelledby="all-records-title">
    <div class="section-heading"><div><p class="eyebrow">Listado completo</p><h2 id="all-records-title">Registros</h2></div><p class="count-note">{records.length} {records.length === 1 ? 'registro publicado' : 'registros publicados'}</p></div>
    {records.length === 0
      ? <EmptyState message="Todavía no hay publicaciones disponibles." />
      : <ol class="record-list">
        {records.map((record) => {
          const bdnsView = buildBDNSRecordView(record);
          return <li><RecordCard record={record} href={`/registro/${encodeRecordId(record.id)}/`} source={sourceLabel(record.sourceId, data.sources)} category={categoryLabel(record.category)} date={primaryDate(record)} geography={geographyLabels(record)} hasHistory={(data.eventsByRecordId.get(record.id) ?? []).length > 0} bdnsSummary={bdnsView ? { callType: bdnsView.callType, budget: bdnsView.budget } : undefined} /></li>;
        })}
      </ol>}
  </section>
</BaseLayout>
