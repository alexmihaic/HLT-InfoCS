---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BDNSHumanReadableDetail from '../../components/BDNSHumanReadableDetail.astro';
import ChangeTimeline from '../../components/ChangeTimeline.astro';
import InfoCsDerived from '../../components/InfoCsDerived.astro';
import OfficialData from '../../components/OfficialData.astro';
import RecordMeta from '../../components/RecordMeta.astro';
import SourceLink from '../../components/SourceLink.astro';
import TechnicalDetails from '../../components/TechnicalDetails.astro';
import { encodeRecordId, loadPortalData } from '../../lib/data';
import { formatPortalDate } from '../../lib/presentation/dates';
import { administrationLevelLabel, categoryLabel, sourceLabel } from '../../lib/presentation/labels';
import { authorityPresentation, geographyLabels, isUppercaseTitle, officialDeadline, primaryDate, showsAdministrationLevel, timelineItems } from '../../lib/presentation/recordView';
import { buildBDNSRecordView } from '../../lib/presentation/bdnsRecordView';
import type { FrontendEvent, FrontendRecord, SourceMeta } from '../../lib/data/types';

interface Props { record: FrontendRecord; events: readonly FrontendEvent[]; source: SourceMeta }

export async function getStaticPaths() {
  const data = await loadPortalData();
  return data.records.map((record) => {
    const source = data.sources.find((item) => item.sourceId === record.sourceId);
    if (!source) throw new Error('No se encontró metadata editorial de una fuente publicada.');
    return { params: { slug: encodeRecordId(record.id) }, props: { record, events: data.eventsByRecordId.get(record.id) ?? [], source } };
  });
}

const { record, events, source } = Astro.props as Props;
const bdnsView = buildBDNSRecordView(record);
const geographies = geographyLabels(record);
const date = primaryDate(record);
const timeline = timelineItems(events);
const recordPath = `/registro/${encodeRecordId(record.id)}/`;
const authority = authorityPresentation(record);
const deadline = officialDeadline(record);
---

<BaseLayout title={record.title} description={`Ficha pública de ${categoryLabel(record.category)} en InfoCs.`}>
  <article class="detail-page" data-pagefind-body>
    <div class="visually-hidden" data-pagefind-ignore aria-hidden="true">
      <span data-pagefind-meta="kind">record</span>
      <span data-pagefind-meta="source">{sourceLabel(record.sourceId, [source])}</span>
      <span data-pagefind-meta="category">{categoryLabel(record.category)}</span>
      {authority && authority.label === 'Organismo' && <span data-pagefind-meta="authority">{authority.value}</span>}
      <span data-pagefind-meta="primary_date_iso">{date.value}</span>
      <span data-pagefind-meta="primary_date_label">{date.label}</span>
      <span data-pagefind-meta="primary_date_value">{date.display}</span>
      <span data-pagefind-meta="public_url">{recordPath}</span>
      {bdnsView?.callType && <span data-pagefind-meta="bdns_call_type">{bdnsView.callType.value}</span>}
      {bdnsView?.budget && <>
        <span data-pagefind-meta="bdns_budget_display">{bdnsView.budget.displayValue}</span>
        {bdnsView.budget.currency && <span data-pagefind-meta="bdns_budget_currency">{bdnsView.budget.currency}</span>}
        {bdnsView.budget.currencyNotice && <span data-pagefind-meta="bdns_budget_currency_notice">{bdnsView.budget.currencyNotice}</span>}
      </>}
    </div>
    <nav class="breadcrumbs" aria-label="Ruta de navegación">
      <a href="/">Inicio</a><span aria-hidden="true">/</span><a href="/registros/">Registros</a><span aria-hidden="true">/</span><span aria-current="page">Ficha</span>
    </nav>

    <header class="detail-header">
      <RecordMeta source={sourceLabel(record.sourceId, [source])} category={categoryLabel(record.category)} />
      <h1 class:list={{ 'is-uppercase': isUppercaseTitle(record.title) }}>{record.title}</h1>
      {bdnsView?.officialTitleCoofficial && <p class="detail-subtitle"><span class="fact-label">{bdnsView.officialTitleCoofficial.label}: </span>{bdnsView.officialTitleCoofficial.value}</p>}
    </header>

    <section class="key-facts" aria-label="Datos clave">
      <dl class="key-facts-grid">
        <div><dt>{date.label}</dt><dd><time datetime={date.value}>{date.display}</time></dd></div>
        {deadline && <div><dt>{deadline.label}</dt><dd>{deadline.date && <time datetime={deadline.date.value}>{deadline.date.display}</time>}{deadline.date && deadline.text && <span> · </span>}{deadline.text && <span>{deadline.text}</span>}</dd></div>}
        {bdnsView?.budget && <div><dt>{bdnsView.budget.label}</dt><dd><span class="money">{bdnsView.budget.displayValue}</span>{bdnsView.budget.currency && <span> {bdnsView.budget.currency}</span>}{bdnsView.budget.currencyNotice && <span class="fact-note">{bdnsView.budget.currencyNotice}</span>}</dd></div>}
        {authority && <div class="key-facts-wide"><dt>{authority.label}</dt><dd>{authority.value}</dd></div>}
      </dl>
      <div class="key-facts-actions" data-pagefind-ignore>
        <SourceLink href={record.sourceUrl} variant="primary" label={record.sourceId === 'bdns' ? 'Datos oficiales en BDNS (JSON de la API)' : record.sourceId === 'boe' ? 'Abrir publicación oficial en el BOE' : 'Abrir publicación oficial'} />
        {record.sourceId === 'bdns' && <p class="fact-note">El enlace abre la respuesta en formato JSON de la API oficial de BDNS, no una ficha web.</p>}
      </div>
    </section>

    <div class="detail-layout">
      <div class="detail-main">
        <OfficialData>
          <dl class="detail-grid">
            {record.publishedAt && <div><dt>Publicado</dt><dd><time datetime={record.publishedAt}>{formatPortalDate(record.publishedAt)}</time></dd></div>}
            {record.eventAt && <div><dt>Fecha del acto</dt><dd><time datetime={record.eventAt}>{formatPortalDate(record.eventAt)}</time></dd></div>}
            {record.sourceId === 'bdns' && record.grant?.callId && <div><dt>Código BDNS</dt><dd class="mono-value">{record.grant.callId}</dd></div>}
            {record.sourceId === 'boe' && record.officialId && <div><dt>Identificador BOE</dt><dd class="mono-value">{record.officialId}</dd></div>}
          </dl>
          {bdnsView && <BDNSHumanReadableDetail view={bdnsView} />}
        </OfficialData>
        <ChangeTimeline items={timeline} />
      </div>

      <aside class="detail-aside" aria-label="Información complementaria">
        <InfoCsDerived>
          <dl class="detail-grid detail-grid-single">
            <div><dt>Tipo</dt><dd>{categoryLabel(record.category)}</dd></div>
            {record.administrationLevel && showsAdministrationLevel(record) && <div><dt>Nivel administrativo</dt><dd>{administrationLevelLabel(record.administrationLevel)}</dd></div>}
            {geographies.length > 0 && <div><dt>Ámbito territorial</dt><dd>{geographies.join(' · ')}</dd></div>}
          </dl>
          <p class="fact-note">Los campos no disponibles en la fuente o no normalizados no se completan.</p>
        </InfoCsDerived>

        <section class="surface-panel aside-panel" aria-labelledby="source-panel-title">
          <p class="panel-kicker">Procedencia</p>
          <h2 id="source-panel-title">Fuente oficial</h2>
          <p>El contenido íntegro y la interpretación oficial corresponden al organismo editor.</p>
          {bdnsView && <p data-pagefind-ignore>Los datos de esta ficha proceden de la Base de Datos Nacional de Subvenciones (BDNS) mediante su fuente oficial.</p>}
          {source.attribution && <p class="attribution">{source.attribution}</p>}
        </section>

        <section class="surface-panel aside-panel" aria-labelledby="method-note-title">
          <p class="panel-kicker">Trazabilidad</p>
          <h2 id="method-note-title">Procesamiento por InfoCs</h2>
          <p>InfoCs organiza metadatos estructurados, conserva el enlace oficial y aplica controles de privacidad antes de publicar. Esta ficha no sustituye a la fuente original ni ofrece asesoramiento jurídico.</p>
        </section>

        <div data-pagefind-ignore><TechnicalDetails recordId={record.id} officialId={record.officialId} contentHash={record.contentHash} detectedAt={record.detectedAt} lastCheckedAt={record.lastCheckedAt} /></div>
      </aside>
    </div>
  </article>
</BaseLayout>
