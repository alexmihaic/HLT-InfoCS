---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RecordCard from '../../components/RecordCard.astro';
import { encodeRecordId, loadPortalData } from '../../lib/data';
import { categoryLabel, sourceLabel } from '../../lib/presentation/labels';
import { byPrimaryDateDesc, geographyLabels, primaryDate } from '../../lib/presentation/recordView';
import { buildBDNSRecordView } from '../../lib/presentation/bdnsRecordView';
import { AUTHORITY_GROUP_LABEL, authorityGroups, type AuthorityGroup } from '../../lib/presentation/authorities';
import type { FrontendSource } from '../../lib/data/types';

interface Props { group: AuthorityGroup; sources: readonly FrontendSource[]; historyIds: readonly string[] }

export async function getStaticPaths() {
  const data = await loadPortalData();
  const historyIds = [...data.eventsByRecordId.keys()];
  return authorityGroups(data.records).map((group) => ({
    params: { slug: group.slug },
    props: { group, sources: data.sources, historyIds },
  }));
}

const { group, sources, historyIds } = Astro.props as Props;
const withHistory = new Set(historyIds);
const records = [...group.records].sort(byPrimaryDateDesc);
---

<BaseLayout title={`${group.name} · Organismos`} description={`Convocatorias de subvenciones de ${group.name} según BDNS, publicadas en InfoCs.`} currentPage="organisms">
  <article class="content-shell">
    <nav class="breadcrumbs" aria-label="Ruta de navegación">
      <a href="/organismos/">Organismos</a><span aria-hidden="true">/</span><span aria-current="page">{group.name}</span>
    </nav>
    <header class="page-intro">
      <p class="eyebrow">{AUTHORITY_GROUP_LABEL}</p>
      <h1>{group.name}</h1>
      <p class="lede">{records.length} {records.length === 1 ? 'convocatoria publicada' : 'convocatorias publicadas'} en InfoCs con esta administración convocante según BDNS. Puede no incluir todas sus convocatorias: sólo las que entran en el alcance territorial de InfoCs.</p>
    </header>
    <ol class="record-list">
      {records.map((record) => {
        const bdnsView = buildBDNSRecordView(record);
        return <li><RecordCard record={record} href={`/registro/${encodeRecordId(record.id)}/`} source={sourceLabel(record.sourceId, sources)} category={categoryLabel(record.category)} date={primaryDate(record)} geography={geographyLabels(record)} hasHistory={withHistory.has(record.id)} bdnsSummary={bdnsView ? { callType: bdnsView.callType, budget: bdnsView.budget } : undefined} /></li>;
      })}
    </ol>
  </article>
</BaseLayout>
